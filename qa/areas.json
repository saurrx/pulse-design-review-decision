{
  "_doc": "Source glob -> feature areas, for pulse-frontend. A path matching nothing is treated as a FULL run.",
  "contractSha256": "e01c8ec9ce22bf0777fa722dae1f4344d2a8e48b571c64640016aad483ce965c",
  "testRoots": [
    "src",
    "qa"
  ],
  "runners": [
    {
      "_doc": "Static security gates under qa/security/ are standalone node scripts (no browser, no build). Declared before the generic runner so the tier's intent is explicit; same command, so behaviour is identical.",
      "match": "qa/security/.*\\.mjs$",
      "command": [
        "node"
      ],
      "each": true
    },
    {
      "_doc": "Browser + node tiers are standalone scripts. each:true keeps them sequential, which is what stops five role logins racing the login throttle.",
      "match": "\\.qa\\.mjs$",
      "command": [
        "node"
      ],
      "each": true
    }
  ],
  "checkpoints": {
    "_doc": "Which shared-contract checkpoints this repo participates in. \"tagged\" = select by @cp: tag and fail if that selects nothing; \"all\" = every tagged test file; \"n/a: <reason>\" = no such surface here, exits 0. A contract checkpoint missing from this map is an error, so adding one forces every repo to decide what it does about it.",
    "smoke": "tagged",
    "pre-deploy": "tagged",
    "post-deploy": "tagged",
    "nightly": "all"
  },
  "map": {
